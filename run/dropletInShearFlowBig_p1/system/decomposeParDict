FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// NOTE: the Allrun script for this case runs CahnHilliardFoam directly
// (no decomposePar/mpirun/reconstructPar), i.e. in serial. This file is
// currently not used; the settings below are kept only as a starting
// point for future parallel runs.
numberOfSubdomains 1;

method          simple;

simpleCoeffs
{
    n               ( 1 1 1 );
    delta           0.001;
}

hierarchicalCoeffs
{
    n               ( 1 1 1 );
    delta           0.001;
    order           xyz;
}

manualCoeffs
{
    dataFile        "";
}

distributed     no;

roots           ( );


